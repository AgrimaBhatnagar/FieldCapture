{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fieldcapture.job/0.1",
  "type": "object",
  "required": [
    "schema",
    "job_id",
    "started_at",
    "session",
    "captures",
    "line_items"
  ],
  "properties": {
    "schema": {
      "const": "fieldcapture.job/0.1"
    },
    "job_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "session": {
      "type": "object",
      "required": [
        "state",
        "device_mode",
        "drop_recoveries"
      ],
      "properties": {
        "state": {
          "enum": [
            "idle",
            "active",
            "paused",
            "stopped"
          ]
        },
        "device_mode": {
          "enum": [
            "mock_device_kit",
            "phone_camera_fallback",
            "browser_webcam"
          ]
        },
        "drop_recoveries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "ts",
          "sync",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "nameplate",
              "damage",
              "note"
            ]
          },
          "ts": {
            "type": "string"
          },
          "sync": {
            "enum": [
              "queued",
              "synced"
            ]
          },
          "quality": {
            "type": [
              "object",
              "null"
            ]
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "value",
                "confidence",
                "source"
              ],
              "properties": {
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "source": {
                  "enum": [
                    "voice",
                    "model",
                    "tech",
                    "keyword",
                    "pending"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "qty",
          "confidence"
        ],
        "properties": {
          "code": {
            "pattern": "^[A-Z]{2,3}-\\d{2}$"
          },
          "qty": {
            "type": [
              "number",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
